# 复制成 .env 再填写:
#     cp .env.example .env
#
# 装了 python-dotenv 的话, import agents0to1 时会自动读取这个文件。
# 没装也不影响 —— 直接设系统环境变量一样用。

# ==================== 至少填一个 ====================
# 用哪家就填哪家的 key, 框架会自动认出 provider
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...        # 通义千问
# MODELSCOPE_API_KEY=ms-...
# KIMI_API_KEY=sk-...
# ZHIPU_API_KEY=...

# ==================== 可选 ====================
# 不填就按 provider 用默认值
# LLM_MODEL_ID=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT=60
# LOG_LEVEL=INFO

# 本地跑模型不需要 key, 填地址就行
# OLLAMA_HOST=http://localhost:11434/v1
# VLLM_HOST=http://localhost:8000/v1

# ==================== 记忆层 / Embedding(和 chat 是两套独立配置) ====================
# DeepSeek 没有 embeddings 端点, 所以 embedding 必须另外配一家。
# 不配的话记忆层构造时会报「没能自动检测出 embedding provider」, 但**不影响 chat**。
#
# ⚠️ 强烈建议把 EMBEDDING_PROVIDER 写死。不写的话两张表都只是"按检测顺序挑一个",
#    命中多个 key 时只 logger.warning、不报错 —— 也就是说 chat 可能在你不注意的
#    时候**静默**换成另一家。钉死它, 这类偏差才不会悄悄发生。
# EMBEDDING_PROVIDER=zhipu     # openai / dashscope / zhipu / modelscope / ollama
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_API_KEY=           # 不填就按 provider 找对应的 key(如 ZHIPU_API_KEY)

# ==================== 向量库 ====================
# blob(默认, 快) / json(慢, 但能用眼睛看) —— 两种格式可以在同一张表里共存
# VECTOR_STORAGE=blob

# ==================== 流式调用的用量统计 ====================
# 开了才会在流式响应里返回 usage(token 数)。不是所有 OpenAI 兼容服务都认这个
# 字段(老版本 vLLM 可能直接 400) —— 撞上了就把它设成 false。
# LLM_STREAM_USAGE=true

# ==================== 搜索工具(可选) ====================
# 不填的话 SearchTool 会返回一段配置提示, 不影响其它功能
# TAVILY_API_KEY=tvly-...
# SERPAPI_API_KEY=...
