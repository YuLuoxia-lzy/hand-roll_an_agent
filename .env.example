# 复制成 .env 再填写:
#     cp .env.example .env
#
# 装了 python-dotenv 的话, import agents0to1 时会自动读取这个文件。
# 没装也不影响 —— 直接设系统环境变量一样用。

# ==================== 至少填一个 ====================
# 用哪家就填哪家的 key, 框架会自动认出 provider
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...        # 通义千问
# MODELSCOPE_API_KEY=ms-...
# KIMI_API_KEY=sk-...
# ZHIPU_API_KEY=...

# ==================== 可选 ====================
# 不填就按 provider 用默认值
# LLM_MODEL_ID=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT=60
# LOG_LEVEL=INFO

# 本地跑模型不需要 key, 填地址就行
# OLLAMA_HOST=http://localhost:11434/v1
# VLLM_HOST=http://localhost:8000/v1

# ==================== 搜索工具(可选) ====================
# 不填的话 SearchTool 会返回一段配置提示, 不影响其它功能
# TAVILY_API_KEY=tvly-...
# SERPAPI_API_KEY=...
